# Copy to .env and fill in
AT_USERNAME=sandbox
AT_API_KEY=your_africastalking_api_key
# Optional: approved alphanumeric sender ID / shortcode for SMS (leave blank in sandbox)
AT_SENDER_ID=
# Optional: Africa's Talking voice number (e.g. +254711082XXX) for the USSD "Call" option
AT_VOICE_NUMBER=
# Postgres connection string (e.g. from Neon). Leave blank to use local SQLite
DATABASE_URL=
# Any long random string; signs mobile app logins
SECRET_KEY=
# Admin page at /admin (feature switches, complaints). Leave blank to disable it.
ADMIN_PASSWORD=
# Background jobs: a cron service POSTs /internal/tick with this in the X-Tick-Secret header
TICK_SECRET=
# Optional: key for encrypting contacts at rest (turned on at /admin). Generate with:
#   python -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Same key everywhere that uses the same database. Losing it loses encrypted contacts.
CONTACTS_KEY=
# Optional: email (verification and notifications, turned on at /admin)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
PORT=8000
# Optional: AI answers in the /help chat assistant (Claude). Without it the assistant answers from the built-in FAQ.
ANTHROPIC_API_KEY=
# CHATBOT_AI=off   # keep the built-in answers even when a key is set
# Testing only: every SMS code (signup, reset, OTP login) is this and nothing is texted. Ignored on Render.
# TEST_OTP_CODE=123456
