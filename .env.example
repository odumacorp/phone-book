# Copy to .env and fill in
AT_USERNAME=sandbox
AT_API_KEY=your_africastalking_api_key
# Optional: approved alphanumeric sender ID / shortcode for SMS (leave blank in sandbox)
AT_SENDER_ID=
# Optional: Africa's Talking voice number (e.g. +254711082XXX) for the USSD "Call" option
AT_VOICE_NUMBER=
# Postgres connection string (e.g. from Neon). Leave blank to use local SQLite
DATABASE_URL=
# Any long random string; signs mobile app logins
SECRET_KEY=
PORT=8000
