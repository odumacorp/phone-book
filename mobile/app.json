{
  "expo": {
    "name": "Remote Phonebook",
    "slug": "phone-book",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.odumacorp.phonebook",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.odumacorp.phonebook",
      "permissions": [
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS",
        "android.permission.RECORD_AUDIO"
      ],
      "blockedPermissions": [
        "android.permission.WRITE_CONTACTS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single",
      "name": "Remote Phonebook",
      "shortName": "Phonebook",
      "description": "Manage the phone book you reach by dialling *384*88041#.",
      "themeColor": "#0B6E4F",
      "backgroundColor": "#F6F7F6",
      "lang": "en"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-contacts",
        {
          "contactsPermission": "Remote Phonebook lets you choose contacts to add to your phone book, so you can reach them by USSD."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Remote Phonebook lets you choose a profile photo.",
          "cameraPermission": "Remote Phonebook lets you take a profile photo."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "351efd9c-410d-49c6-bc73-7740123bde60"
      }
    },
    "owner": "odumacorp"
  }
}
