{
  "expo": {
    "name": "Remote Phonebook",
    "slug": "phone-book",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.odumacorp.phonebook",
      "permissions": [
        "android.permission.READ_CONTACTS"
      ],
      "blockedPermissions": [
        "android.permission.WRITE_CONTACTS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single",
      "name": "Remote Phonebook",
      "shortName": "Phonebook",
      "description": "Manage the phone book you reach by dialling *384*88041#.",
      "themeColor": "#0B6E4F",
      "backgroundColor": "#F6F7F6",
      "lang": "en"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-contacts",
        {
          "contactsPermission": "Remote Phonebook lets you choose contacts to add to your phone book, so you can reach them by USSD."
        }
      ]
    ]
  }
}
